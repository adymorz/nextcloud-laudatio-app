{
	"name": "dymorz/laudatio",
	"description": "Nextcloud app: never miss the birthdays, anniversaries and yearly gifts of the people engaged in your organization",
	"license": "AGPL-3.0-or-later",
	"homepage": "https://github.com/adymorz/nextcloud-laudatio-app",
	"support": {
		"issues": "https://github.com/adymorz/nextcloud-laudatio-app/issues",
		"source": "https://github.com/adymorz/nextcloud-laudatio-app",
		"security": "https://github.com/adymorz/nextcloud-laudatio-app/blob/main/SECURITY.md"
	},
	"authors": [
		{
			"name": "Adrian Dymorz",
			"email": "dev@adrian.dymorz.ch"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\Laudatio\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\Laudatio\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './node_modules/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test": "phpunit -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
		"test:unit": "@test --testsuite unit",
		"test:integration": "@test --testsuite integration",
		"openapi": "generate-spec",
		"rector": "rector && composer cs:fix"
	},
	"require": {
		"php": "^8.2"
	},
	"require-dev": {
		"bamarni/composer-bin-plugin": "^1.8",
		"nextcloud/ocp": "dev-stable34",
		"sabre/vobject": "4.5.6",
		"symfony/console": "^6.4"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.2"
		}
	},
	"extra": {
		"bamarni-bin": {
			"bin-links": true,
			"forward-command": false
		}
	}
}
