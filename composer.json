{
	"name": "dymorz/appreciation",
	"description": "Appreciation app for Nextcloud",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Adrian Dymorz",
			"email": "dev@adrian.dymorz.ch"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\Appreciation\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\Appreciation\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './node_modules/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test:unit": "phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
		"openapi": "generate-spec",
		"rector": "rector && composer cs:fix"
	},
	"require": {
		"bamarni/composer-bin-plugin": "^1.8",
		"php": "^8.3"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable35",
		"sabre/vobject": "4.5.6"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.3"
		}
	},
	"extra": {
		"bamarni-bin": {
			"bin-links": true,
			"forward-command": false
		}
	}
}
