<psalm
	errorLevel="1"
	resolveFromConfigFile="true"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor-bin/psalm/vendor/vimeo/psalm/config.xsd"
	findUnusedBaselineEntry="true"
	findUnusedCode="true"
	phpVersion="8.2"
>
	<projectFiles>
		<directory name="lib" />
		<ignoreFiles>
			<directory name="vendor" />
		</ignoreFiles>
	</projectFiles>
	<extraFiles>
		<directory name="vendor"/>
	</extraFiles>
	<issueHandlers>
		<!-- Nextcloud 34's schema API returns Doctrine tables; Doctrine is not part of nextcloud/ocp -->
		<UndefinedDocblockClass>
			<errorLevel type="suppress">
				<referencedClass name="Doctrine\DBAL\Schema\Table"/>
			</errorLevel>
		</UndefinedDocblockClass>
		<!-- Entities are accessed through Entity's magic getters/setters and Entity::$id is set by the mapper -->
		<PossiblyUnusedProperty>
			<errorLevel type="suppress">
				<directory name="lib/Db"/>
			</errorLevel>
		</PossiblyUnusedProperty>
		<PropertyNotSetInConstructor>
			<errorLevel type="suppress">
				<directory name="lib/Db"/>
			</errorLevel>
		</PropertyNotSetInConstructor>
		<!-- Constructors are called by the dependency injection container -->
		<PossiblyUnusedMethod>
			<errorLevel type="suppress">
				<referencedMethod name="*::__construct"/>
			</errorLevel>
		</PossiblyUnusedMethod>
		<!-- Instantiated by Nextcloud (info.xml, routes, registration) -->
		<UnusedClass>
			<errorLevel type="suppress">
				<directory name="lib/BackgroundJob"/>
				<directory name="lib/Calendar"/>
				<directory name="lib/Command"/>
				<directory name="lib/Controller"/>
				<directory name="lib/Listener"/>
				<directory name="lib/Migration"/>
				<directory name="lib/Notification"/>
				<directory name="lib/Settings"/>
			</errorLevel>
		</UnusedClass>
	</issueHandlers>
</psalm>
